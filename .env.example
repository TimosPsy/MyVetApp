# JWT Token Settings
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=http://localhost:8081
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_HERE

# Ports and Origins Configuration
CORS_ORIGINS=http://localhost:5173
APP_PORT=8081
DB_PORT=1437

# System Administrator (sa) Password used ONLY for initial Docker SQL Server setup
SA_PASSWORD=YOUR_STRONG_SA_PASSWORD

# Application Database Credentials (The isolated user used by the API)
DB_HOST=sqlserver
DB_NAME=MyVetMVCDB
DB_USER=vet_app_user
DB_USER_PASSWORD=YOUR_STRONG_DB_USER_PASSWORD

# Environment Setup
ASPNETCORE_ENVIRONMENT=Development
